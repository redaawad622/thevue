{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@thevue/core": ["./packages/core/src/index.ts"],
      "@thevue/icons": ["./packages/icons/src/index.ts"],
      "@thevue/btn": ["./packages/btn/src/index.ts"],
      "@thevue/table": ["./packages/table/src/index.ts"],
      "@thevue/vue": ["./packages/vue/src/index.ts"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  }
}

{
  "name": "@thevue/icons",
  "type": "module",
  "version": "0.0.1",
  "description": "Icon component for the thevue framework — 200k+ icons via Iconify plus a custom SVG registry",
  "license": "MIT",
  "homepage": "https://github.com/redaawad622/thevue/tree/main/packages/icons#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redaawad622/thevue.git",
    "directory": "packages/icons"
  },
  "keywords": [
    "vue",
    "thevue",
    "icons",
    "iconify"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./style": "./dist/style.css"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@thevue/core": "workspace:*",
    "vue": ">=3.3.0"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0"
  }
}
